# Threat Intelligence Scanner - Environment Variables Template
# Copy this file to .env.local and add your API keys.
# Free tiers are available for all services below:

# 1. VirusTotal API v3 (Used for URLs, IP Addresses, Hashes, and File Uploads)
# Get a free key (500 requests/day, 4 req/min): https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# 2. AbuseIPDB API v2 (Used for IP Reputation & Abuse Confidence Scores)
# Get a free key (1,000 checks/day): https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# 3. Google Safe Browsing API v4 (Used for URL Phishing & Malware Lookup)
# Get a free key (10,000 requests/day): https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here
